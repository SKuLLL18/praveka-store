ADMIN_PASSWORD=change-this-password
PORT=3000
# Razorpay keys (use Test keys first, Live keys when you are ready to go live).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you type in Razorpay Dashboard > Webhooks (any long random text). Needed for payment recovery.
RAZORPAY_WEBHOOK_SECRET=
# Folder for application data and admin-uploaded product photos/videos.
# On hosting, point this to a persistent disk mount so uploads survive redeploys.
# DATA_DIR=/var/data

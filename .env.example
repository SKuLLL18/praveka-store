ADMIN_PASSWORD=change-this-password
PORT=3000
# Razorpay keys (use Test keys first, Live keys when you are ready to go live).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you type in Razorpay Dashboard > Webhooks (any long random text). Needed for payment recovery.
RAZORPAY_WEBHOOK_SECRET=
# Optional: folder for orders/messages/backups. Set this to your persistent disk path on the host.
# DATA_DIR=/var/data

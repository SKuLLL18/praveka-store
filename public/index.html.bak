     CONTACT PAGE
     ========================================= -->

<section class="phead pg" data-p="contact">

    <div class="wrap">

        <h1>Contact Us</h1>

        <p>
            Talk to our team about products, orders or crop advice.
        </p>

    </div>

</section>


<section class="contact-page pg" data-p="contact">

    <div class="wrap contact-layout">


        <!-- =====================================
             LEFT COLUMN
             ===================================== -->

        <div class="contact-details">


            <!-- WhatsApp -->

            <div class="contact-box">

                <div class="contact-box-icon whatsapp">
                    <i class="fab fa-whatsapp"></i>
                </div>

                <div class="contact-box-content">

                    <h3>WhatsApp</h3>

                    <p>
                        Get product details, price, availability
                        or any support on WhatsApp.
                    </p>

                    <a
                        href="https://wa.me/916359414594"
                        target="_blank"
                        rel="noopener"
                        class="contact-action"
                    >
                        <span>WhatsApp</span>
                        <strong>+91 63594 14594</strong>
                    </a>

                </div>

            </div>


            <!-- Call -->

            <div class="contact-box">

                <div class="contact-box-icon phone">
                    <i class="fas fa-phone"></i>
                </div>

                <div class="contact-box-content">

                    <h3>Call Us</h3>

                    <p>
                        For direct enquiries or to know more
                        about our products.
                    </p>

                    <a
                        href="tel:+918401968996"
                        class="contact-action"
                    >
                        <span>Call</span>
                        <strong>+91 84019 68996</strong>
                    </a>

                </div>

            </div>


            <!-- Email -->

            <div class="contact-box">

                <div class="contact-box-icon email">
                    <i class="fas fa-envelope"></i>
                </div>

                <div class="contact-box-content">

                    <h3>Email</h3>

                    <p>
                        Send us an email for product information
                        or business enquiries.
                    </p>

                    <a
                        href="mailto:pravekalifescience@gmail.com"
                        class="contact-action"
                    >
                        <span>Email</span>
                        <strong>pravekalifescience@gmail.com</strong>
                    </a>

                </div>

            </div>


            <!-- Address -->

            <div class="contact-box">

                <div class="contact-box-icon location">
                    <i class="fas fa-map-marker-alt"></i>
                </div>

                <div class="contact-box-content">

                    <h3>Our Address</h3>

                    <p class="address-text">
                        Ground Floor, Plot No. 36, S.R. No-212,
                        Karmabumi Estate, Atlas Industrial Area,
                        Dhebar Road, Kothariya Part,
                        Nr. Gondal Road, Rajkot,
                        Gujarat – 360022.
                    </p>

                    <a
                        href="https://www.google.com/maps/search/?api=1&query=Praveka%20Life%20Science%20Rajkot%20Gujarat"
                        target="_blank"
                        rel="noopener"
                        class="map-link"
                    >
                        <i class="fas fa-map-marked-alt"></i>
                        View on Google Maps
                    </a>

                </div>

            </div>

        </div>


        <!-- =====================================
             RIGHT COLUMN
             ===================================== -->

        <div class="contact-form-box">

            <div class="contact-form-header">

                <h2>Send us a Message</h2>

                <p>
                    Fill in your details below and our team
                    will get back to you.
                </p>

            </div>


            <form id="contactForm">


                <div class="form-group">

                    <label for="contactName">
                        Name
                    </label>

                    <input
                        type="text"
                        id="contactName"
                        name="name"
                        placeholder="Your name"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="contactPhone">
                        Phone number
                    </label>

                    <input
                        type="tel"
                        id="contactPhone"
                        name="phone"
                        placeholder="Your phone number"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="contactEmail">
                        Email
                    </label>

                    <input
                        type="email"
                        id="contactEmail"
                        name="email"
                        placeholder="Your email address"
                    >

                </div>


                <div class="form-group">

                    <label for="contactMessage">
                        Message
                    </label>

                    <textarea
                        id="contactMessage"
                        name="message"
                        rows="6"
                        placeholder="How can we help you?"
                        required
                    ></textarea>

                </div>


                <button
                    type="submit"
                    class="contact-submit"
                >
                    <i class="fas fa-paper-plane"></i>
                    Send Message
                </button>


            </form>

        </div>


    </div>

</section>

